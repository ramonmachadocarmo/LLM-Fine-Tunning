FROM ./models/my_experiment.gguf

# Llama 3 / 3.2 — default in this repo for Llama bases.
# Gemma 2: the UI Register button picks the Gemma template automatically.

TEMPLATE """{{- if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{- end }}
{{- range .Messages }}
{{- if eq .Role "user" }}<|start_header_id|>user<|end_header_id|>

{{ .Content }}<|eot_id|>
{{- else if eq .Role "assistant" }}<|start_header_id|>assistant<|end_header_id|>

{{ .Content }}<|eot_id|>
{{- end }}
{{- end }}<|start_header_id|>assistant<|end_header_id|>
"""

SYSTEM """You are a helpful assistant. Follow the user's instructions carefully."""

PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"
PARAMETER temperature 0.2
PARAMETER top_p 0.9
