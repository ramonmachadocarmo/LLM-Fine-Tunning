# --- Python / Poetry ---
.venv/
.venv.bak/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
*.swp

# --- Secrets / local env ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# --- Logs ---
*.log
logs/

# --- Datasets (keep folder + sample) ---
data/*
!data/.gitkeep
!data/sample.jsonl
!data/*.sample.jsonl
!data/README.md

# --- Adapters / checkpoints ---
adapters/*
!adapters/.gitkeep
!adapters/README.md

# --- Exported / local models ---
models/*
!models/.gitkeep
!models/README.md
merged_models/*
!merged_models/.gitkeep
!merged_models/README.md

# --- Configs (keep templates only) ---
configs/*
!configs/.gitkeep
!configs/*.template.yaml
!configs/README.md
!configs/ui/
configs/ui/*
!configs/ui/.gitkeep
!configs/ui/*.template.yaml

# --- Clone on demand (export / tooling) ---
llama.cpp/
graphify-out/

